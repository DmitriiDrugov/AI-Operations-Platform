# =============================================================================
# AI Operations Platform — Environment Variables
# Copy to .env.local (never commit real values)
# =============================================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # Backend only; never expose to client

# --- Anthropic (Claude API) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- OpenAI (embeddings only) ---
OPENAI_API_KEY=sk-...

# --- AWS ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_SQS_NOTIFICATION_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/...
AWS_SQS_OUTBOX_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/...
AWS_S3_DOCUMENTS_BUCKET=your-documents-bucket

# --- Redis (ARQ worker) ---
REDIS_URL=redis://localhost:6379/0

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Twilio ---
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_NUMBER=+14155238886

# --- SendGrid ---
SENDGRID_API_KEY=SG...
SENDGRID_FROM_EMAIL=noreply@yourwellness.com
SENDGRID_FROM_NAME=Your Wellness Platform

# --- Notion ---
NOTION_INTEGRATION_TOKEN=secret_...
NOTION_KNOWLEDGE_BASE_ID=...

# --- Slack ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_OPERATIONS_CHANNEL=#operations
SLACK_FINANCE_CHANNEL=#finance
SLACK_ENGINEERING_CHANNEL=#engineering-alerts

# --- Application ---
APP_ENV=development  # development | staging | production
LOG_LEVEL=INFO
SECRET_KEY=generate-a-random-32-char-string  # Used for HMAC webhook validation
AI_CORE_SERVICE_URL=http://localhost:8000
